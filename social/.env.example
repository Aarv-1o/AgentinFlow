# Copy to social/.env and fill in. social/.env is gitignored.
OPENAI_API_KEY=sk-...

# Optional
OPENAI_MODEL=gpt-4o-mini

# --- X (M3) ---
# developer.x.com -> Project -> App -> User authentication settings
# Type: Web App / Confidential client.  Register the callback exactly.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8721/callback

# --- LinkedIn (M4) ---
# Needs the Community Management API product approved (w_organization_social).
# LINKEDIN_ORG_ID is the numeric company page id, not the vanity name.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ID=
LINKEDIN_REDIRECT_URI=http://localhost:8722/callback
# YYYYMM. LinkedIn sunsets versions; bump when yours is deprecated.
LINKEDIN_VERSION=202607
