---
// One decorative panel holding a slowly rotating solid.
//
// Its own component because Astro frontmatter is plain JavaScript - a
// function returning markup only works in a .astro file.
//
// Purely decorative: the parent column carries pointer-events:none and
// aria-hidden, so hover and click do nothing and screen readers skip it.
const { shape, tone = 'cool', spin = '18s', dir = 'normal' } = Astro.props;

const CUBE_FACES = ['front', 'back', 'right', 'left', 'top', 'bottom'];
const HOURGLASS_PLANES = ['0deg', '60deg', '120deg'];
---

<div class={`panel is-${tone}`}>
    <div class="stage">
        <div class={`obj is-${shape}`} style={`--spin:${spin}; --dir:${dir}`}>
            {shape === 'cube' && CUBE_FACES.map((f) => <span class={`f ${f}`}></span>)}

            {shape === 'phone' && (
                <>
                    <span class="p front"><i>AF</i></span>
                    <span class="p back"></span>
                    <span class="p right"></span>
                    <span class="p left"></span>
                </>
            )}

            {shape === 'laptop' && (
                <>
                    <span class="l lid"><i>AF</i></span>
                    <span class="l deck"></span>
                </>
            )}

            {/* Three silhouettes crossed at 60 degrees. A single flat shape
                would vanish edge-on twice a turn; three read as volume from
                any angle, for a fraction of a true solid's geometry. */}
            {shape === 'hourglass' && HOURGLASS_PLANES.map((a) => <span class="h" style={`--a:${a}`}></span>)}
        </div>
    </div>
</div>

<style>
    .panel {
        display: grid;
        place-items: center;
        aspect-ratio: 4 / 3;
        border-radius: 1rem;
        border: 1px solid var(--border);
        background: radial-gradient(120% 100% at 50% 0%, #1e1e1e 0%, #0e0e0e 72%);
        overflow: hidden;
    }

    .is-warm {
        background: radial-gradient(120% 100% at 50% 0%, rgba(var(--accent-rgb), 0.3) 0%, #131313 72%);
    }

    /* perspective on the stage, never on the spinning element itself -
       there it flattens the rotation away. */
    .stage {
        perspective: 620px;
    }

    .obj {
        position: relative;
        width: 88px;
        height: 88px;
        transform-style: preserve-3d;
        /* Tilted so the tops of the solids read, then spun about the vertical. */
        animation: spin-y var(--spin, 18s) linear infinite;
        animation-direction: var(--dir, normal);
    }

    @keyframes spin-y {
        from {
            transform: rotateX(-14deg) rotateY(0deg);
        }

        to {
            transform: rotateX(-14deg) rotateY(360deg);
        }
    }

    /* --- Cube --- */
    .f {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: linear-gradient(150deg, rgba(255, 255, 255, 0.17), rgba(255, 255, 255, 0.03));
    }

    .f.front {
        transform: translateZ(44px);
    }

    .f.back {
        transform: rotateY(180deg) translateZ(44px);
    }

    .f.right {
        transform: rotateY(90deg) translateZ(44px);
    }

    .f.left {
        transform: rotateY(-90deg) translateZ(44px);
    }

    .f.top {
        transform: rotateX(90deg) translateZ(44px);
        background: linear-gradient(150deg, rgba(var(--accent-rgb), 0.75), rgba(var(--accent-rgb), 0.25));
    }

    .f.bottom {
        transform: rotateX(-90deg) translateZ(44px);
    }

    /* --- Phone --- */
    .p {
        position: absolute;
        top: 50%;
        left: 50%;
        border: 1px solid rgba(255, 255, 255, 0.26);
        border-radius: 8px;
        background: linear-gradient(160deg, #3d3d3d, #1c1c1c);
    }

    .p.front,
    .p.back {
        width: 54px;
        height: 100px;
        margin: -50px 0 0 -27px;
    }

    .p.front {
        display: grid;
        place-items: center;
        background: #000;
        transform: translateZ(7px);
    }

    .p.front i {
        font-family: var(--font-display);
        font-style: normal;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--accent);
        text-shadow: 0 0 14px rgba(var(--accent-rgb), 0.7);
    }

    .p.back {
        transform: rotateY(180deg) translateZ(7px);
    }

    .p.right,
    .p.left {
        width: 14px;
        height: 100px;
        margin: -50px 0 0 -7px;
        border-radius: 3px;
    }

    .p.right {
        transform: rotateY(90deg) translateZ(27px);
    }

    .p.left {
        transform: rotateY(-90deg) translateZ(27px);
    }

    /* --- Laptop --- */
    .l {
        position: absolute;
        left: 50%;
        border: 1px solid rgba(255, 255, 255, 0.26);
    }

    .l.lid {
        top: 2px;
        display: grid;
        place-items: center;
        width: 100px;
        height: 62px;
        margin-left: -50px;
        border-radius: 5px;
        background: #000;
    }

    .l.lid i {
        font-family: var(--font-display);
        font-style: normal;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--accent);
        text-shadow: 0 0 14px rgba(var(--accent-rgb), 0.7);
    }

    .l.deck {
        top: 66px;
        width: 112px;
        height: 54px;
        margin-left: -56px;
        border-radius: 4px;
        background: linear-gradient(160deg, #3f3f3f, #1c1c1c);
        transform-origin: top center;
        transform: rotateX(78deg);
    }

    /* --- Hourglass --- */
    .h {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 64px;
        height: 86px;
        margin: -43px 0 0 -32px;
        transform: rotateY(var(--a));
        background: linear-gradient(180deg,
                rgba(var(--accent-rgb), 0.85) 0%,
                rgba(var(--accent-rgb), 0.35) 48%,
                rgba(var(--accent-rgb), 0.35) 52%,
                rgba(var(--accent-rgb), 0.85) 100%);
        clip-path: polygon(4% 0, 96% 0, 96% 8%, 56% 48%, 56% 52%, 96% 92%, 96% 100%,
                4% 100%, 4% 92%, 44% 52%, 44% 48%, 4% 8%);
    }

    @media (prefers-reduced-motion: reduce) {
        .obj {
            animation: none;
            transform: rotateX(-14deg) rotateY(-28deg);
        }
    }
</style>
