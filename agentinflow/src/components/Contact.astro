---
// Enquiry form plus direct channels.
//
// Lives on the Services page and carries id="contact", which is the target
// every CTA on the site points at. Until a booking system exists this is the
// single place a visitor can reach us from.
//
// The field ids (name, email, company, message, website, formStatus,
// submitBtn, btnText, btnIcon) are what src/scripts/contact.js looks up.
// Renaming any of them silently breaks the form.
const WHATSAPP = '919343393388';
const PHONE = '+919343393388';
const PHONE_DISPLAY = '+91 93433 93388';
---

<section class="contact" id="contact">
    <div class="contact-inner">
        <header class="contact-head">
            <span class="eyebrow">Get in touch</span>
            <h2>Tell us what is slowing you down</h2>
            <p>We will tell you whether it is worth automating, in plain terms. Usually within one business day.</p>
        </header>

        <div class="channels">
            <a class="channel is-whatsapp"
                href={`https://wa.me/${WHATSAPP}?text=Hi%20AgentinFlow%2C%20I%20would%20like%20to%20discuss%20a%20project.`}
                target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                        d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
                    <path
                        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.25 8.24z" />
                </svg>
                <span>
                    <span class="channel-label">Message us</span>
                    <span class="channel-value">WhatsApp {PHONE_DISPLAY}</span>
                </span>
            </a>

            <a class="channel" href={`tel:${PHONE}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>
                    <span class="channel-label">Prefer to talk?</span>
                    <span class="channel-value">Call {PHONE_DISPLAY}</span>
                </span>
            </a>
        </div>

        <p class="divider"><span>or send us the details</span></p>

        <form id="contactForm" novalidate>
            <div class="form-row">
                <div class="form-group">
                    <label for="name">Name *</label>
                    <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name"
                        aria-describedby="nameError" />
                    <span class="field-error" id="nameError"></span>
                </div>
                <div class="form-group">
                    <label for="email">Email *</label>
                    <input type="email" id="email" name="email" placeholder="your@email.com" required
                        autocomplete="email" aria-describedby="emailError" />
                    <span class="field-error" id="emailError"></span>
                </div>
            </div>

            <div class="form-group">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" placeholder="Your company name"
                    autocomplete="organization" />
            </div>

            <div class="form-group">
                <label for="message">Message *</label>
                <textarea id="message" name="message" rows="5" placeholder="Tell us about your project..." required
                    aria-describedby="messageError"></textarea>
                <span class="field-error" id="messageError"></span>
            </div>

            <!-- Anti-spam honeypot: off-screen rather than display:none, which
                 bots skip. Kept in the layout and merely invisible. -->
            <div class="hp-field" aria-hidden="true">
                <label for="website">Website</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>

            <button type="submit" class="submit-btn" id="submitBtn">
                <span id="btnText">Send Message</span>
                <svg id="btnIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </button>
        </form>
    </div>
</section>

<style>
    .contact {
        padding: clamp(4rem, 12vh, 7rem) 1.5rem;
        background-color: var(--bg);
        border-top: 1px solid var(--border);
    }

    .contact-inner {
        max-width: 680px;
        margin: 0 auto;
    }

    .contact-head {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .eyebrow {
        display: block;
        margin-bottom: 0.85rem;
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .contact-head h2 {
        margin: 0 0 0.85rem;
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--heading);
    }

    .contact-head p {
        margin: 0;
        color: var(--text);
        font-size: 1.05rem;
        line-height: 1.6;
    }

    /* --- Direct channels --- */
    .channels {
        display: grid;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .channel {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--border);
        border-radius: 0.9rem;
        background-color: var(--surface);
        color: var(--text);
        text-decoration: none;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .channel:hover,
    .channel:focus-visible {
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .channel svg {
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        color: var(--accent);
    }

    .is-whatsapp svg {
        color: var(--whatsapp);
    }

    .is-whatsapp:hover,
    .is-whatsapp:focus-visible {
        border-color: var(--whatsapp);
    }

    .channel-label {
        display: block;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .channel-value {
        display: block;
        margin-top: 0.15rem;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--heading);
    }

    /* --- Divider --- */
    .divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 0 2rem;
        color: var(--text-dim);
        font-size: 0.9rem;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background-color: var(--border);
    }

    /* --- Form --- */
    .form-row {
        display: grid;
        gap: 1.25rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: var(--text);
    }

    input,
    textarea {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid var(--border);
        border-radius: 0.6rem;
        background-color: var(--bg-alt);
        color: var(--heading);
        font-family: var(--font-body);
        font-size: 1rem;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }

    input::placeholder,
    textarea::placeholder {
        color: var(--text-dim);
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.18);
    }

    textarea {
        resize: vertical;
    }

    .field-error {
        display: block;
        min-height: 1.15rem;
        margin-top: 0.35rem;
        font-size: 0.85rem;
        color: var(--danger);
    }

    input.has-error,
    textarea.has-error {
        border-color: var(--danger);
        box-shadow: 0 0 0 3px rgba(var(--danger-rgb), 0.12);
    }

    /* Honeypot: off-screen, not display:none - bots skip hidden fields. */
    .hp-field {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }

    /* --- Status banner --- */
    .form-status {
        display: none;
        margin-bottom: 1.25rem;
        padding: 1rem 1.25rem;
        border: 1px solid transparent;
        border-radius: 0.75rem;
        font-size: 0.975rem;
        line-height: 1.55;
    }

    .form-status.is-visible {
        display: block;
    }

    .form-status.is-success {
        background-color: rgba(var(--success-rgb), 0.1);
        border-color: rgba(var(--success-rgb), 0.35);
        color: var(--success);
    }

    .form-status.is-error {
        background-color: rgba(var(--accent-rgb), 0.1);
        border-color: rgba(var(--accent-rgb), 0.4);
        color: var(--danger-soft);
    }

    .form-status :global(a) {
        color: inherit;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .form-status :global(.status-actions) {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin-top: 0.65rem;
    }

    .form-status :global(.status-detail) {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        opacity: 0.7;
    }

    /* --- Submit --- */
    .submit-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 1rem 2rem;
        border: none;
        border-radius: 9999px;
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .submit-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(var(--accent-rgb), 0.35);
    }

    .submit-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    @media (min-width: 640px) {
        .form-row {
            grid-template-columns: 1fr 1fr;
        }

        .channels {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .channel,
        .submit-btn {
            transition: none;
        }

        .channel:hover,
        .submit-btn:hover:not(:disabled) {
            transform: none;
        }
    }
</style>

<script>
    import '../scripts/contact.js';
</script>
