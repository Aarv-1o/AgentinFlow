---
// Scroll-driven hero.
//
// A tall outer track holds a sticky viewport-height stage. How far the track
// has passed the top of the screen becomes a 0-1 value published as the CSS
// custom property --p on the stage. Everything inside reads that one number,
// so the sequence is scrubbed by scroll position rather than played on a timer.
//
// Layers: the wordmark sits behind (z-index 1), the keypad in front (z-index 2),
// so the object occludes the letters.
//
// The keypad is drawn as inline SVG in a true isometric projection rather than
// sourced as a 3D model - a few kilobytes, no runtime, no asset licence, and it
// resolves through the palette tokens.

// --- Isometric projection ---------------------------------------------------
// Grid units in, screen coordinates out. z is a straight pixel lift, so key
// height is independent of footprint.
const U = 92;
const CX = 400;
const CY = 200;
const COS30 = 0.8660254;

const iso = (x, y, z = 0) => ({
    X: CX + (x - y) * COS30 * U,
    Y: CY + (x + y) * 0.5 * U - z
});

const p = (pt) => `${pt.X.toFixed(1)},${pt.Y.toFixed(1)}`;

// A tapered slab: square footprint, smaller top face, two visible side walls.
// The taper is what makes a keycap read as a keycap rather than a box.
function slab(x0, y0, size, height, taper) {
    const x1 = x0 + size;
    const y1 = y0 + size;

    const b = {
        back: iso(x0, y0), right: iso(x1, y0),
        front: iso(x1, y1), left: iso(x0, y1)
    };
    const t = {
        back: iso(x0 + taper, y0 + taper, height),
        right: iso(x1 - taper, y0 + taper, height),
        front: iso(x1 - taper, y1 - taper, height),
        left: iso(x0 + taper, y1 - taper, height)
    };

    return {
        top: `M${p(t.back)} L${p(t.right)} L${p(t.front)} L${p(t.left)} Z`,
        // Only the two faces meeting at the front corner are visible.
        wallR: `M${p(b.right)} L${p(b.front)} L${p(t.front)} L${p(t.right)} Z`,
        wallL: `M${p(b.left)} L${p(b.front)} L${p(t.front)} L${p(t.left)} Z`,
        centre: iso((x0 + x1) / 2, (y0 + y1) / 2, height)
    };
}

const KEY_SIZE = 0.84;
const KEY_H = 42;
const KEY_TAPER = 0.12;

const plate = slab(-0.2, -0.2, 2.24, 22, 0.02);

const keys = [
    { i: 0, j: 0, label: 'WEB' },
    { i: 1, j: 0, label: 'AI' },
    { i: 0, j: 1, label: 'N8N' },
    { i: 1, j: 1, label: 'GO', go: true }
].map((k) => ({
    ...k,
    ...slab(k.i, k.j, KEY_SIZE, KEY_H, KEY_TAPER),
    // Back keys land first, so the stack builds away-to-near.
    delay: (k.i + k.j) * 0.16,
    // Larger i+j sits nearer the viewer and must paint last.
    depth: k.i + k.j
})).sort((a, b) => a.depth - b.depth);

const goKey = keys.find((k) => k.go);

// Labels must lie in the top plane rather than face the screen, or they float
// above the cap. This matrix maps flat text onto that plane.
const LABEL_TF = `${COS30} 0.5 ${-COS30} 0.5`;
---

<section class="hero-track" id="heroTrack">
    <div class="hero-stage" id="heroStage">
        <h1 class="wordmark-back" aria-label="AgentinFlow">AGENTINFLOW</h1>

        <div class="stage-object">
            <svg class="keypad" viewBox="0 0 800 600" role="img"
                aria-label="An isometric keypad assembling, with keys labelled Web, AI, n8n and Go">
                <defs>
                    <linearGradient id="capTop" x1="0" y1="0" x2="0.6" y2="1">
                        <stop offset="0%" stop-color="#ffffff" />
                        <stop offset="100%" stop-color="#d7dade" />
                    </linearGradient>
                    <linearGradient id="capTopGo" x1="0" y1="0" x2="0.6" y2="1">
                        <stop offset="0%" stop-color="#b52c4b" />
                        <stop offset="100%" stop-color="#6d1830" />
                    </linearGradient>
                    <linearGradient id="plateTop" x1="0" y1="0" x2="0.5" y2="1">
                        <stop offset="0%" stop-color="#333333" />
                        <stop offset="100%" stop-color="#1e1e1e" />
                    </linearGradient>
                    <radialGradient id="goGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.75" />
                        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                    </radialGradient>
                </defs>

                <ellipse class="ground" cx="400" cy="350" rx="250" ry="70" />

                <!-- Base plate -->
                <g class="plate">
                    <path d={plate.wallL} fill="#101010" />
                    <path d={plate.wallR} fill="#171717" />
                    <path d={plate.top} fill="url(#plateTop)" />
                </g>

                <!-- Glow beneath GO, ramps as the key is pressed -->
                <ellipse class="go-glow" cx={goKey.centre.X} cy={goKey.centre.Y + 26}
                    rx="130" ry="64" fill="url(#goGlow)" />

                <!-- Keycaps, painted back to front -->
                {keys.map((k) => (
                    <g class={k.go ? 'cap is-go' : 'cap'} style={`--d:${k.delay}`}>
                        <path d={k.wallL} fill={k.go ? '#4d1122' : '#8f9499'} />
                        <path d={k.wallR} fill={k.go ? '#5d1527' : '#a9aeb3'} />
                        <path d={k.top} fill={k.go ? 'url(#capTopGo)' : 'url(#capTop)'} />
                        <text x="0" y="0" class="cap-label"
                            transform={`matrix(${LABEL_TF} ${k.centre.X} ${k.centre.Y})`}
                            fill={k.go ? '#ffffff' : '#3a3f44'}>{k.label}</text>
                    </g>
                ))}
            </svg>
        </div>

        <p class="hero-line">We build what you ask</p>
    </div>
</section>

<style>
    .hero-track {
        position: relative;
        height: 240vh;
    }

    .hero-stage {
        position: sticky;
        top: 0;
        height: 100vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        --p: 0;
    }

    /* --- Wordmark, behind --- */
    .wordmark-back {
        grid-area: 1 / 1;
        z-index: 1;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.75rem, 12.5vw, 13rem);
        line-height: 1;
        letter-spacing: -0.03em;
        white-space: nowrap;
        color: var(--heading);
        user-select: none;
        opacity: calc(1 - var(--p) * 0.55);
        transform: translateY(calc(var(--p) * -3vh));
    }

    /* --- Keypad, in front --- */
    .stage-object {
        grid-area: 1 / 1;
        z-index: 2;
        display: grid;
        place-items: center;
        width: min(52vw, 560px);
        aspect-ratio: 4 / 3;
    }

    .keypad {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .ground {
        fill: #000;
        opacity: calc(var(--p) * 0.5);
    }

    /* Plate settles first, before any cap arrives */
    .plate {
        --reveal: clamp(0, calc(var(--p) * 4), 1);
        opacity: var(--reveal);
        transform: translateY(calc((1 - var(--reveal)) * 90px));
    }

    /* Caps drop in, back row first */
    .cap {
        --reveal: clamp(0, calc((var(--p) - 0.15 - var(--d)) * 3.4), 1);
        opacity: var(--reveal);
        transform: translateY(calc((1 - var(--reveal)) * -190px));
    }

    /* GO is pressed at the end of the scroll, glow arriving with it */
    .is-go {
        --press: clamp(0, calc((var(--p) - 0.84) * 6), 1);
        transform: translateY(calc((1 - var(--reveal)) * -190px + var(--press) * 15px));
    }

    .go-glow {
        opacity: clamp(0, calc((var(--p) - 0.84) * 6), 1);
    }

    .cap-label {
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-anchor: middle;
        dominant-baseline: central;
    }

    /* --- Bottom line --- */
    .hero-line {
        position: absolute;
        bottom: 3.5rem;
        z-index: 3;
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.35rem);
        letter-spacing: 0.02em;
        color: var(--text);
        opacity: var(--p);
        transform: translateY(calc((1 - var(--p)) * 1.5rem));
    }

    /* Without scroll the sequence never advances, so hold it assembled and
       drop the runway to a single screen. */
    @media (prefers-reduced-motion: reduce) {
        .hero-track {
            height: 100vh;
        }

        .hero-stage {
            --p: 1 !important;
        }
    }
</style>

<script>
    const track = document.getElementById('heroTrack');
    const stage = document.getElementById('heroStage');

    if (track && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;

        const update = () => {
            const runway = track.offsetHeight - window.innerHeight;
            const scrolled = -track.getBoundingClientRect().top;
            const progress = runway > 0 ? Math.min(1, Math.max(0, scrolled / runway)) : 0;
            stage.style.setProperty('--p', progress.toFixed(4));
            ticking = false;
        };

        // rAF-throttled: scroll fires far more often than the screen repaints
        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        update();
    }
</script>
