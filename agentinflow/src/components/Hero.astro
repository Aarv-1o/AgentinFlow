---
// Scroll-driven hero.
//
// Structure: a tall outer track holds a sticky viewport-height stage. How far
// the track has passed the top of the screen becomes a 0-1 progress value,
// published as the CSS custom property --p on the stage. Everything inside
// reads that one number, so the animation is scrubbed by scroll position
// rather than played on a timer.
//
// The laptop is drawn as inline SVG rather than sourced as a 3D model: the
// perspective is baked into the geometry, so it reads as a solid object at a
// few kilobytes with no 3D runtime. If a rendered asset replaces it later,
// only the <svg> and its part rules change - the progress mechanism and
// layering stay as they are.
//
// Layers: the wordmark sits behind (z-index 1), the stage object in front
// (z-index 2), so the object occludes the letters.

// Keyboard keys are generated rather than hand-written. The deck is drawn in
// perspective - it widens towards the viewer - so each row sits at its own
// depth. edgeAt() interpolates the deck's left and right edge for a given y,
// and every key is measured against that.
const DECK_TOP_Y = 384, DECK_BOT_Y = 470;
const DECK_TOP_L = 110, DECK_TOP_R = 690;
const DECK_BOT_L = 40, DECK_BOT_R = 760;

const edgeAt = (y) => {
    const t = (y - DECK_TOP_Y) / (DECK_BOT_Y - DECK_TOP_Y);
    return {
        left: DECK_TOP_L + (DECK_BOT_L - DECK_TOP_L) * t,
        right: DECK_TOP_R + (DECK_BOT_R - DECK_TOP_R) * t
    };
};

const ROWS = 5, PER_ROW = 14, GAP = 2.2;
const keys = [];

for (let r = 0; r < ROWS; r++) {
    const y = 394 + r * 8.4;
    const { left, right } = edgeAt(y);
    const inset = 58 + r * 2;
    const x0 = left + inset;
    const kw = (right - inset - x0 - GAP * (PER_ROW - 1)) / PER_ROW;

    for (let c = 0; c < PER_ROW; c++) {
        keys.push({
            x: +(x0 + c * (kw + GAP)).toFixed(2),
            y: +y.toFixed(2),
            w: +kw.toFixed(2),
            h: 6.2,
            // staggered reveal: left to right, back row to front
            delay: +((r * PER_ROW + c) / (ROWS * PER_ROW) * 0.75).toFixed(3)
        });
    }
}

---

<section class="hero-track" id="heroTrack">
    <div class="hero-stage" id="heroStage">
        <h1 class="wordmark-back" aria-label="AgentinFlow">AGENTINFLOW</h1>

        <div class="stage-object">
            <svg class="laptop" viewBox="0 0 800 600" role="img"
                aria-label="A laptop assembling itself, part by part">
                <defs>
                    <linearGradient id="lidFace" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#2b2b2b" />
                        <stop offset="100%" stop-color="#161616" />
                    </linearGradient>
                    <linearGradient id="deckFace" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#242424" />
                        <stop offset="100%" stop-color="#131313" />
                    </linearGradient>
                    <linearGradient id="edgeSheen" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.02" />
                        <stop offset="50%" stop-color="#ffffff" stop-opacity="0.16" />
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
                    </linearGradient>
                    <radialGradient id="screenGlow" cx="50%" cy="12%" r="85%">
                        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.85" />
                        <stop offset="55%" stop-color="var(--accent-strong)" stop-opacity="0.22" />
                        <stop offset="100%" stop-color="var(--accent-strong)" stop-opacity="0" />
                    </radialGradient>
                </defs>

                <!-- soft contact shadow, grounds the object -->
                <ellipse class="pt shadow" cx="400" cy="482" rx="330" ry="20" />

                <!-- lid -->
                <g class="pt lid">
                    <rect x="140" y="40" width="520" height="332" rx="15" fill="url(#lidFace)"
                        stroke="var(--glass-border)" />
                    <rect x="154" y="54" width="492" height="304" rx="8" fill="#0b0b0b" />
                    <rect class="glow" x="154" y="54" width="492" height="304" rx="8" fill="url(#screenGlow)" />
                    <rect x="154" y="54" width="492" height="304" rx="8" fill="none"
                        stroke="var(--glass-highlight)" stroke-width="0.75" />
                </g>

                <!-- hinge -->
                <rect class="pt hinge" x="128" y="371" width="544" height="11" rx="5.5"
                    fill="#1d1d1d" stroke="var(--glass-border)" />

                <!-- deck, drawn in perspective -->
                <g class="pt deck">
                    <path d="M110 384 H690 L760 470 Q760 478 750 478 H50 Q40 478 40 470 Z"
                        fill="url(#deckFace)" stroke="var(--glass-border)" />
                    <path d="M110 385 H690" stroke="url(#edgeSheen)" stroke-width="1.5" fill="none" />
                </g>

                <!-- keys -->
                <g class="pt keys">
                    {keys.map((k) => (
                        <rect x={k.x} y={k.y} width={k.w} height={k.h} rx="1.6"
                            fill="#2c2c2c" style={`--d:${k.delay}`} />
                    ))}
                </g>

                <!-- trackpad -->
                <path class="pt pad" d="M338 442 H462 L472 468 H328 Z" fill="#1f1f1f"
                    stroke="var(--glass-border)" />
            </svg>
        </div>

        <p class="hero-line">We build what you ask</p>
    </div>
</section>

<style>
    /* The track is what gets scrolled through; its extra height is the
       runway the animation plays across. */
    .hero-track {
        position: relative;
        height: 260vh;
    }

    .hero-stage {
        position: sticky;
        top: 0;
        height: 100vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        --p: 0;
    }

    /* --- Wordmark, behind --- */
    .wordmark-back {
        grid-area: 1 / 1;
        z-index: 1;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.75rem, 12.5vw, 13rem);
        line-height: 1;
        letter-spacing: -0.03em;
        white-space: nowrap;
        color: var(--heading);
        user-select: none;

        /* Drifts up and fades back very slightly as the object assembles,
           so the two layers feel like one move rather than two. */
        opacity: calc(1 - var(--p) * 0.55);
        transform: translateY(calc(var(--p) * -3vh));
    }

    /* --- Object, in front --- */
    .stage-object {
        grid-area: 1 / 1;
        z-index: 2;
        display: grid;
        place-items: center;
        width: min(46vw, 520px);
        aspect-ratio: 4 / 3;
    }

    /* --- Laptop ---
       Vector rather than a 3D asset: perspective is drawn into the geometry,
       so it reads as a solid object while staying a few kilobytes and needing
       no runtime. Every part is positioned by --p alone.

       Transforms use px, which inside an SVG resolve to viewBox user units,
       so the motion scales with the drawing rather than the viewport. */
    .laptop {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .shadow {
        fill: #000;
        opacity: calc(var(--p) * 0.55);
    }

    /* Lid drops in from above and settles */
    .lid {
        transform: translateY(calc((1 - var(--p)) * -340px));
        opacity: calc(0.15 + var(--p) * 0.85);
    }

    .glow {
        opacity: calc(var(--p) * var(--p));
    }

    /* Hinge draws outward from the centre */
    .hinge {
        transform: scaleX(var(--p));
        transform-origin: 400px 377px;
        opacity: calc(0.2 + var(--p) * 0.8);
    }

    /* Deck rises from below */
    .deck {
        transform: translateY(calc((1 - var(--p)) * 320px));
        opacity: calc(0.15 + var(--p) * 0.85);
    }

    /* Keys land in sequence. Each carries its own --d offset, so the row
       fills left to right and front to back instead of appearing at once. */
    .keys rect {
        /* One reveal value per key, derived once and reused for both
           properties, rather than nesting clamp inside calc twice. */
        --reveal: clamp(0, calc((var(--p) - var(--d)) * 5), 1);
        opacity: var(--reveal);
        transform: translateY(calc((1 - var(--reveal)) * 26px));
    }

    .pad {
        --reveal: clamp(0, calc((var(--p) - 0.72) * 4), 1);
        opacity: var(--reveal);
        transform: translateY(calc((1 - var(--reveal)) * 22px));
    }

    /* --- Bottom line --- */
    .hero-line {
        position: absolute;
        bottom: 3.5rem;
        z-index: 3;
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.35rem);
        letter-spacing: 0.02em;
        color: var(--text);
        opacity: var(--p);
        transform: translateY(calc((1 - var(--p)) * 1.5rem));
    }

    /* Without scroll the animation never advances, so hold it assembled
       and drop the runway to a single screen. */
    @media (prefers-reduced-motion: reduce) {
        .hero-track {
            height: 100vh;
        }

        .hero-stage {
            --p: 1 !important;
        }
    }
</style>

<script>
    const track = document.getElementById('heroTrack');
    const stage = document.getElementById('heroStage');

    if (track && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;

        const update = () => {
            const runway = track.offsetHeight - window.innerHeight;
            const scrolled = -track.getBoundingClientRect().top;
            const p = runway > 0 ? Math.min(1, Math.max(0, scrolled / runway)) : 0;
            stage.style.setProperty('--p', p.toFixed(4));
            ticking = false;
        };

        // rAF-throttled: scroll fires far more often than the screen repaints
        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        update();
    }
</script>
