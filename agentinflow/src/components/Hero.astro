---
// Hero: three stacked rows - wordmark, keypad, line.
//
// The keypad is inline SVG in a true isometric projection: a few kilobytes,
// no 3D runtime, no asset licence, and every colour resolves through the
// palette tokens.
//
// Motion is no longer scroll-driven. The keypad sways through a shallow angle
// on a loop, and individual caps press when hovered.

// --- Isometric projection ---------------------------------------------------
// Grid units in, screen coordinates out. z is a straight pixel lift, so key
// height is independent of footprint.
const U = 92;
const CX = 400;
const CY = 210;
const COS30 = 0.8660254;

const iso = (x, y, z = 0) => ({
    X: CX + (x - y) * COS30 * U,
    Y: CY + (x + y) * 0.5 * U - z
});

const p = (pt) => `${pt.X.toFixed(1)},${pt.Y.toFixed(1)}`;

// A tapered slab: square footprint, smaller top face, two visible side walls.
// The taper is what makes a keycap read as a keycap rather than a box.
function slab(x0, y0, size, height, taper) {
    const x1 = x0 + size;
    const y1 = y0 + size;

    const b = {
        back: iso(x0, y0), right: iso(x1, y0),
        front: iso(x1, y1), left: iso(x0, y1)
    };
    const t = {
        back: iso(x0 + taper, y0 + taper, height),
        right: iso(x1 - taper, y0 + taper, height),
        front: iso(x1 - taper, y1 - taper, height),
        left: iso(x0 + taper, y1 - taper, height)
    };

    return {
        top: `M${p(t.back)} L${p(t.right)} L${p(t.front)} L${p(t.left)} Z`,
        // Only the two faces meeting at the front corner are visible.
        wallR: `M${p(b.right)} L${p(b.front)} L${p(t.front)} L${p(t.right)} Z`,
        wallL: `M${p(b.left)} L${p(b.front)} L${p(t.front)} L${p(t.left)} Z`,
        centre: iso((x0 + x1) / 2, (y0 + y1) / 2, height)
    };
}

const KEY_SIZE = 0.84;
const KEY_H = 42;
const KEY_TAPER = 0.12;

const plate = slab(-0.2, -0.2, 2.24, 22, 0.02);

const keys = [
    { i: 0, j: 0, label: 'WEB' },
    { i: 1, j: 0, label: 'AI' },
    { i: 0, j: 1, label: 'N8N' },
    { i: 1, j: 1, label: 'GO', go: true }
].map((k) => ({
    ...k,
    ...slab(k.i, k.j, KEY_SIZE, KEY_H, KEY_TAPER),
    // Larger i+j sits nearer the viewer and must paint last: SVG has no
    // z-buffer, so paint order is the depth order.
    depth: k.i + k.j
})).sort((a, b) => a.depth - b.depth);

const goKey = keys.find((k) => k.go);

// Labels must lie in the top plane rather than face the screen, or they float
// above the cap. This matrix maps flat text onto that plane.
const LABEL_TF = `${COS30} 0.5 ${-COS30} 0.5`;
---

<section class="hero">
    <h1 class="wordmark">AGENTINFLOW</h1>

    <div class="stage">
        <div class="sway">
            <svg class="keypad" viewBox="0 0 800 480" role="img"
                aria-label="An isometric keypad with keys labelled Web, AI, n8n and Go">
                <defs>
                    <linearGradient id="capTop" x1="0" y1="0" x2="0.6" y2="1">
                        <stop offset="0%" stop-color="#ffffff" />
                        <stop offset="100%" stop-color="#d7dade" />
                    </linearGradient>
                    <linearGradient id="capTopGo" x1="0" y1="0" x2="0.6" y2="1">
                        <stop offset="0%" stop-color="#b52c4b" />
                        <stop offset="100%" stop-color="#6d1830" />
                    </linearGradient>
                    <linearGradient id="plateTop" x1="0" y1="0" x2="0.5" y2="1">
                        <stop offset="0%" stop-color="#333333" />
                        <stop offset="100%" stop-color="#1e1e1e" />
                    </linearGradient>
                    <radialGradient id="goGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.8" />
                        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                    </radialGradient>
                </defs>

                <ellipse class="ground" cx="400" cy="358" rx="250" ry="70" />

                <g class="plate">
                    <path d={plate.wallL} fill="#101010" />
                    <path d={plate.wallR} fill="#171717" />
                    <path d={plate.top} fill="url(#plateTop)" />
                </g>

                <ellipse class="go-glow" cx={goKey.centre.X} cy={goKey.centre.Y + 26}
                    rx="130" ry="64" fill="url(#goGlow)" />

                <!-- Caps, painted back to front -->
                {keys.map((k) => (
                    <g class={k.go ? 'cap is-go' : 'cap'} tabindex="0" role="button"
                        aria-label={`${k.label} key`}>
                        <path d={k.wallL} fill={k.go ? '#4d1122' : '#8f9499'} />
                        <path d={k.wallR} fill={k.go ? '#5d1527' : '#a9aeb3'} />
                        <path d={k.top} fill={k.go ? 'url(#capTopGo)' : 'url(#capTop)'} />
                        <text x="0" y="0" class="cap-label"
                            transform={`matrix(${LABEL_TF} ${k.centre.X} ${k.centre.Y})`}
                            fill={k.go ? '#ffffff' : '#3a3f44'}>{k.label}</text>
                    </g>
                ))}
            </svg>
        </div>
    </div>

    <p class="hero-line">We build what you ask</p>
</section>

<style>
    /* Three stacked rows, centred as a column. */
    .hero {
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto auto auto;
        align-content: center;
        justify-items: center;
        gap: clamp(1rem, 3vh, 2.5rem);
        padding: 8rem 1.5rem 4rem;
        text-align: center;
    }

    .wordmark {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.25rem, 10vw, 9rem);
        line-height: 1;
        letter-spacing: -0.03em;
        white-space: nowrap;
        color: var(--heading);
        user-select: none;
    }

    /* perspective has to sit on the parent for the child's rotation to have
       any depth - applied to the child it flattens. */
    .stage {
        width: min(70vw, 520px);
        perspective: 1100px;
    }

    .sway {
        transform-style: preserve-3d;
        animation: keypad-sway 11s ease-in-out infinite;
    }

    /* A shallow oscillation rather than a full turn: the drawing is a fixed
       isometric projection, so large angles would expose faces that were
       never drawn. Kept under 10 degrees, where it reads as a sway. */
    @keyframes keypad-sway {

        0%,
        100% {
            transform: rotateY(-9deg) rotateX(2.5deg);
        }

        50% {
            transform: rotateY(9deg) rotateX(-1.5deg);
        }
    }

    .keypad {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .ground {
        fill: #000;
        opacity: 0.5;
    }

    /* --- Press on hover --- */
    .cap {
        cursor: pointer;
        transition: transform 0.16s cubic-bezier(0.34, 1.2, 0.64, 1);
    }

    .cap:hover,
    .cap:focus-visible {
        /* Down the screen only. The caps travel along the plate normal, which
           in this projection is straight down. */
        transform: translateY(11px);
    }

    .cap:focus-visible {
        outline: none;
    }

    .cap:focus-visible .cap-label {
        text-decoration: underline;
    }

    /* GO lights the plate beneath it when pressed */
    .go-glow {
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .keypad:has(.is-go:hover) .go-glow,
    .keypad:has(.is-go:focus-visible) .go-glow {
        opacity: 1;
    }

    .cap-label {
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-anchor: middle;
        dominant-baseline: central;
        pointer-events: none;
    }

    .hero-line {
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.35rem);
        letter-spacing: 0.02em;
        color: var(--text);
    }

    @media (prefers-reduced-motion: reduce) {
        .sway {
            animation: none;
            transform: rotateY(-4deg);
        }

        .cap {
            transition: none;
        }
    }
</style>
