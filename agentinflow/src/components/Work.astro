---
// "Our work" - the proof section, sitting after the hero.
//
// Copy describes only what is verifiable from the live sites: features
// visible on the page, and stacks read from the shipped build output.
// Nothing is inferred about budgets, timelines or outcomes.
//
// `metric` is deliberately absent on both entries. A result figure is the
// most persuasive thing here and the one thing that cannot be derived from
// outside - it has to come from the client. Cards omit the block entirely
// when metric is null, so no empty slot shows and no invented number ships.
const projects = [
    {
        num: '01',
        client: 'Bellemeade Advisors · Healthcare',
        title: 'Prescription price comparison platform',
        problem: 'Patients had no straightforward way to see what the same prescription costs at different pharmacies, so most paid whatever their usual one charged.',
        url: 'https://bellemeade-advisors.onrender.com/',
        metric: null,
        metricLabel: null
    },
    {
        num: '02',
        client: 'Crossing Cultural Boundaries · Non-profit',
        title: 'Cultural exchange and scholarship programme site',
        problem: 'CCB promotes cultural exchange and youth leadership through scholarships and community impact, and needed a public home for that work.',
        url: 'https://www.crossingculturalboundaries.com/',
        metric: null,
        metricLabel: null
    }
];
---

<section class="work" id="work">
    <div class="work-inner">
        <header class="work-head">
            <span class="eyebrow">Our work</span>
            <h2>Built, shipped, and still running</h2>
        </header>

        <ol class="project-list">
            {projects.map((pr) => (
                <li class="project-card">
                    <span class="project-num">{pr.num}</span>
                    <p class="project-client">{pr.client}</p>

                    <h3 class="project-title">
                        {pr.url
                            ? <a href={pr.url} target="_blank" rel="noopener">
                                {pr.title}
                                <svg class="visit-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    aria-hidden="true">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            </a>
                            : pr.title}
                    </h3>

                    <p class="project-problem">{pr.problem}</p>

                    {pr.metric && (
                        <div class="project-metric">
                            <span class="metric-value">{pr.metric}</span>
                            <span class="metric-label">{pr.metricLabel}</span>
                        </div>
                    )}
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    /* Same ground as the hero, with generous clearance above so the two
       sections read as separate without needing a divider line. */
    .work {
        padding: clamp(6rem, 18vh, 12rem) 1.5rem clamp(4rem, 12vh, 8rem);
        background-color: var(--bg);
    }

    .work-inner {
        max-width: 1080px;
        margin: 0 auto;
    }

    /* --- Heading --- */
    .work-head {
        margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }

    .eyebrow {
        display: block;
        margin-bottom: 0.85rem;
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .work-head h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 3rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--heading);
    }

    /* --- Cards, stacked --- */
    .project-list {
        display: grid;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project-card {
        padding: clamp(1.75rem, 4vw, 2.75rem);
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .project-card:hover {
        border-color: var(--accent);
        transform: translateY(-3px);
    }

    .project-num {
        display: block;
        margin-bottom: 1rem;
        font-family: var(--font-display);
        font-size: 0.9rem;
        letter-spacing: 0.16em;
        color: var(--accent);
    }

    .project-client {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .project-title {
        margin: 0 0 1rem;
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 2.6vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--heading);
    }

    .project-title a {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        color: inherit;
        text-decoration: none;
        transition: color 0.25s ease;
    }

    .project-title a:hover,
    .project-title a:focus-visible {
        color: var(--accent);
    }

    .visit-arrow {
        width: 0.6em;
        height: 0.6em;
        flex-shrink: 0;
        opacity: 0.45;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .project-title a:hover .visit-arrow,
    .project-title a:focus-visible .visit-arrow {
        opacity: 1;
        transform: translate(2px, -2px);
    }

    .project-problem {
        margin: 0;
        max-width: 56ch;
        color: var(--text);
        font-size: 1rem;
        line-height: 1.65;
    }

    /* --- Metric (rendered only when one exists) --- */
    .project-metric {
        margin-top: 1.75rem;
    }

    .metric-value {
        display: block;
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--accent);
    }

    .metric-label {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--text-dim);
    }

    @media (prefers-reduced-motion: reduce) {

        .project-card,
        .project-title a,
        .visit-arrow {
            transition: none;
        }

        .project-card:hover {
            transform: none;
        }

        .project-title a:hover .visit-arrow {
            transform: none;
        }
    }
</style>
