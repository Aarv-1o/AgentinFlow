---
// "Our work" - the proof section, sitting after the hero.
//
// Copy describes only what is verifiable from the live sites. Nothing is
// inferred about budgets, timelines or outcomes.
//
// `metric` is deliberately absent on both entries. A result figure is the
// most persuasive thing here and the one thing that cannot be derived from
// outside - it has to come from the client. Cards omit the block entirely
// when metric is null, so no empty slot shows and no invented number ships.
const projects = [
    {
        num: '01',
        client: 'Bellemeade Advisors · Healthcare',
        title: 'Prescription price comparison platform',
        problem: 'Patients had no straightforward way to see what the same prescription costs at different pharmacies, so most paid whatever their usual one charged.',
        metric: null,
        metricLabel: null
    },
    {
        num: '02',
        client: 'Crossing Cultural Boundaries · Non-profit',
        title: 'Cultural exchange and scholarship programme site',
        problem: 'CCB promotes cultural exchange and youth leadership through scholarships and community impact, and needed a public home for that work.',
        metric: null,
        metricLabel: null
    }
];
---

<section class="work" id="work">
    <div class="work-inner">
        <header class="work-head">
            <span class="eyebrow">Our work</span>
            <h2>Built, shipped, and still running</h2>
        </header>

        <ol class="project-list">
            {projects.map((pr) => (
                <li class="project-card">
                    <div class="card-text">
                        <span class="project-num">{pr.num}</span>
                        <p class="project-client">{pr.client}</p>
                        <h3 class="project-title">{pr.title}</h3>
                        <p class="project-problem">{pr.problem}</p>

                        {pr.metric && (
                            <div class="project-metric">
                                <span class="metric-value">{pr.metric}</span>
                                <span class="metric-label">{pr.metricLabel}</span>
                            </div>
                        )}
                    </div>

                    {/* Built from divs in real CSS 3D rather than drawn flat, so
                        the hover turn is an actual rotation and the lid keeps
                        its correct angle to the base throughout. */}
                    <div class="laptop-scene" aria-hidden="true">
                        <div class="turntable">
                            <div class="laptop">
                                <div class="lid">
                                    <div class="screen"><span>AF</span></div>
                                </div>
                                <div class="base">
                                    <div class="keyboard"></div>
                                    <div class="trackpad"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    /* Same ground as the hero, with generous clearance above so the two
       sections read as separate without needing a divider line. */
    .work {
        padding: clamp(6rem, 18vh, 12rem) 1.5rem clamp(4rem, 12vh, 8rem);
        background-color: var(--bg);
    }

    .work-inner {
        max-width: 1080px;
        margin: 0 auto;
    }

    /* --- Heading --- */
    .work-head {
        margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }

    .eyebrow {
        display: block;
        margin-bottom: 0.85rem;
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .work-head h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 3rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--heading);
    }

    /* --- Cards --- */
    .project-list {
        display: grid;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project-card {
        display: grid;
        gap: 2rem;
        align-items: center;
        padding: clamp(1.75rem, 4vw, 2.75rem);
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .project-card:hover {
        border-color: var(--accent);
        transform: translateY(-3px);
    }

    .project-num {
        display: block;
        margin-bottom: 1rem;
        font-family: var(--font-display);
        font-size: 0.9rem;
        letter-spacing: 0.16em;
        color: var(--accent);
    }

    .project-client {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .project-title {
        margin: 0 0 1rem;
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 2.6vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--heading);
    }

    .project-problem {
        margin: 0;
        max-width: 52ch;
        color: var(--text);
        font-size: 1rem;
        line-height: 1.65;
    }

    .project-metric {
        margin-top: 1.75rem;
    }

    .metric-value {
        display: block;
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--accent);
    }

    .metric-label {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--text-dim);
    }

    /* ================= Laptop ================= */
    .laptop-scene {
        justify-self: center;
        width: 260px;
        height: 200px;
        /* perspective belongs on the ancestor; on the rotating element
           itself it flattens the result. */
        perspective: 1000px;
    }

    /* Spins about the world vertical. Kept on its own element so the
       laptop's own tilt is not fighting the hover rotation. */
    .turntable {
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transform: rotateY(var(--ry, -22deg));
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Lays the whole machine back so it is seen from above and in front. */
    .laptop {
        position: relative;
        width: 230px;
        height: 150px;
        margin: 0 auto;
        transform-style: preserve-3d;
        transform: rotateX(62deg);
    }

    .base,
    .lid {
        position: absolute;
        top: 0;
        left: 0;
        width: 230px;
        border-radius: 6px;
    }

    .base {
        height: 150px;
        background: linear-gradient(160deg, #2c2c2c 0%, #171717 100%);
        border: 1px solid #3a3a3a;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
    }

    .keyboard {
        position: absolute;
        inset: 12% 8% 32%;
        border-radius: 3px;
        background: #101010;
        /* Key rows suggested with a repeating gradient rather than 60 divs. */
        background-image:
            repeating-linear-gradient(90deg, #2a2a2a 0 8%, transparent 8% 10%),
            repeating-linear-gradient(0deg, #2a2a2a 0 16%, transparent 16% 20%);
    }

    .trackpad {
        position: absolute;
        left: 50%;
        bottom: 8%;
        width: 34%;
        height: 18%;
        transform: translateX(-50%);
        border-radius: 3px;
        background: #202020;
        border: 1px solid #333;
    }

    /* Hinged at the far edge of the base and swung upright. Slightly past
       90 degrees, which is how a laptop actually sits. */
    .lid {
        height: 145px;
        transform-origin: top center;
        transform: rotateX(-104deg);
        background: linear-gradient(160deg, #303030 0%, #1a1a1a 100%);
        border: 1px solid #3a3a3a;
    }

    .screen {
        position: absolute;
        inset: 7px;
        display: grid;
        place-items: center;
        border-radius: 3px;
        background: #000;
        box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.9);
    }

    .screen span {
        font-family: var(--font-display);
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--accent);
        text-shadow: 0 0 22px rgba(var(--accent-rgb), 0.55);
    }

    /* --- Layout --- */
    @media (min-width: 860px) {
        .project-card {
            grid-template-columns: 1fr 260px;
            gap: 3rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .project-card,
        .turntable {
            transition: none;
        }

        .project-card:hover {
            transform: none;
        }
    }
</style>

<script>
    // Map the pointer's horizontal position across the card onto the
    // turntable's rotation, so the laptop turns with the cursor rather than
    // snapping to a fixed angle. Vertical movement is ignored on purpose.
    const REST = -22;
    const SWING = 30;

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.project-card').forEach((card) => {
            const turntable = card.querySelector('.turntable');
            if (!turntable) return;

            card.addEventListener('pointermove', (e) => {
                const { left, width } = card.getBoundingClientRect();
                // -1 at the left edge, +1 at the right
                const t = ((e.clientX - left) / width) * 2 - 1;
                turntable.style.setProperty('--ry', `${REST + t * SWING}deg`);
            });

            card.addEventListener('pointerleave', () => {
                turntable.style.removeProperty('--ry');
            });
        });
    }
</script>
