---
// Floating nav bar: wordmark left, links centred, CTA right.
// All nav styling lives here rather than being split across global.css and
// the page stylesheets, which is where it used to be.
//
// Active state is derived from the URL instead of being hand-maintained
// per page, which is how the old site did it.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
    { href: '/', label: 'Home' },
    { href: '/service/', label: 'Services' },
    { href: '/aboutus/', label: 'About Us' }
];

const isActive = (href) => (href.replace(/\/+$/, '') || '/') === path;

// The logotype folds: full name at the top of the page, AF once scrolled.
// A and F are the letters that stay, everything between and after them
// collapses.
//
//   A GENTIN F LOW
//   ^        ^
// index 0 and index 7.
const WORD = 'AGENTINFLOW';
const KEEP = new Set([0, 7]);
const letters = [...WORD].map((ch, i) => ({ ch, keep: KEEP.has(i) }));
---

<nav class="site-nav" aria-label="Primary">
    {/* aria-label carries the name: without it a screen reader meeting
        eleven separate spans may spell the word out letter by letter. */}
    <a class="wordmark" href="/" aria-label="AgentinFlow home">
        {letters.map((l) => (
            <span class={l.keep ? 'ltr is-keep' : 'ltr is-fold'} aria-hidden="true">{l.ch}</span>
        ))}
    </a>

    <ul class="nav-links">
        {links.map(({ href, label }) => (
            <li>
                <a href={href} class={isActive(href) ? 'is-active' : ''}
                    aria-current={isActive(href) ? 'page' : undefined}><span class="label">{label}</span></a>
            </li>
        ))}
    </ul>

    <a class="nav-cta" href="/service/#contact">
        <span>Get In Touch</span>
        <span class="nav-cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
            </svg>
        </span>
    </a>
</nav>

<style>
    .site-nav {
        position: fixed;
        top: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;

        width: calc(100% - 3rem);
        max-width: 940px;
        height: 4.25rem;

        /* Three tracks so the centre column stays centred on the bar
           regardless of how wide the wordmark or the CTA get. */
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        padding: 0 0.5rem 0 1.5rem;

        border-radius: 9999px;

        /* Glass: a faint top-to-bottom sheen laid over a translucent
           ground, a hairline border, and an inset highlight along the top
           edge that reads as light catching the lip of a pane. saturate()
           in the backdrop filter is what stops whatever passes underneath
           going grey and flat. */
        border: 1px solid var(--glass-border);
        background-image: linear-gradient(180deg, var(--glass-sheen-top) 0%, var(--glass-sheen-bottom) 100%);
        background-color: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow:
            0 16px 40px rgba(0, 0, 0, 0.45),
            inset 0 1px 0 var(--glass-highlight);
    }

    /* Without backdrop-filter there is nothing to frost, and a 55% ground
       would just look washed out - so fall back to an opaque bar. */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .site-nav {
            background-color: var(--surface);
        }
    }

    /* --- Wordmark --- */
    /* --p is the unfold: 0 is AF, 1 is the full name. It defaults to 1, so
       with no JS or with reduced motion the bar simply shows the name. */
    .wordmark {
        --p: 1;
        justify-self: start;
        display: flex;
        /* Same face as the hero mark. */
        font-family: var(--font-wordmark);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--accent);
        text-decoration: none;
    }

    .ltr {
        display: inline-block;
    }

    /* A and F: white while the name is open, wine once folded to AF. */
    .is-keep {
        color: var(--accent);
        color: color-mix(in srgb, var(--heading) calc(var(--p) * 100%), var(--accent));
    }

    /* The folding letters. Width comes from a measured natural width rather
       than a guessed em value - per-letter guesses drift, and the drift
       shows once nine of them accumulate. Until the measurement lands
       is-ready is absent and the width stays auto, so the name shows in
       full rather than collapsing to nothing. */
    .is-fold {
        overflow: hidden;
        opacity: var(--p);
        color: var(--heading);
    }

    .is-ready .is-fold {
        width: calc(var(--w, 0px) * var(--p));
    }

    /* Has to target the letters: each one sets its own colour, so a rule on
       the anchor alone would never reach them. */
    .wordmark:hover .ltr,
    .wordmark:focus-visible .ltr {
        color: var(--cta-hover);
    }

    /* --- Centre links --- */
    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        display: block;
        padding: 0.55rem 1rem;
        font-size: 0.95rem;
        font-weight: 400;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none;
        color: var(--text);
        transition: color 0.25s ease;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
        color: var(--heading);
    }

    /* Underline sweep. The rule lives on .label rather than the anchor so
       the line spans the text exactly - from the h of Home to the e - and
       not the padded box. */
    .nav-links .label {
        position: relative;
    }

    .nav-links .label::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.35rem;
        height: 1.5px;
        background-color: var(--accent);
        border-radius: 1px;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .nav-links a:hover .label::after,
    .nav-links a:focus-visible .label::after {
        transform: scaleX(1);
    }

    /* Retract from the far end, so the line leaves the way it arrived
       rather than snapping back to the start. */
    .nav-links a:not(:hover) .label::after {
        transform-origin: right center;
    }

    /* The current page is marked by colour alone - the underline is purely
       a hover response and never persists. aria-current carries the state
       for assistive tech. */
    .nav-links a.is-active {
        color: var(--heading);
    }

    /* --- CTA --- */
    .nav-cta {
        justify-self: end;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        height: 3.05rem;
        padding: 0 0.35rem 0 1.35rem;
        border-radius: 9999px;
        border: 1px solid var(--border);
        font-size: 0.95rem;
        font-weight: 400;
        white-space: nowrap;
        text-decoration: none;
        color: var(--heading);
        transition: border-color 0.25s ease, background-color 0.25s ease;
    }

    .nav-cta:hover,
    .nav-cta:focus-visible {
        border-color: var(--accent);
        background-color: var(--surface);
    }

    .nav-cta-icon {
        display: grid;
        place-items: center;
        width: 2.35rem;
        height: 2.35rem;
        border-radius: 50%;
        background-color: var(--cta-bg);
        color: var(--cta-text);
        transition: background-color 0.25s ease, transform 0.25s ease;
    }

    .nav-cta-icon svg {
        width: 15px;
        height: 15px;
    }

    /* A keyframe rather than a transition, so the turn is always clockwise.
       A transition would unwind anticlockwise when the pointer leaves. */
    @keyframes nav-arrow-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .nav-cta:hover .nav-cta-icon,
    .nav-cta:focus-visible .nav-cta-icon {
        background-color: var(--cta-hover);
        animation: nav-arrow-spin 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* --- Narrow screens ---
       The old nav hid its links below 640px. Here the links stay and the
       CTA sheds its label instead, so navigation never disappears. */
    @media (max-width: 900px) {
        .site-nav {
            padding-left: 1.25rem;
        }

        .nav-links a {
            padding: 0.5rem 0.7rem;
            font-size: 0.9rem;
        }
    }

    @media (max-width: 680px) {
        .site-nav {
            top: 1rem;
            width: calc(100% - 1.5rem);
            height: 3.75rem;
            padding: 0 0.5rem 0 1rem;
        }

        .wordmark {
            font-size: 1.25rem;
        }

        /* The mark stays folded on a phone. Open, AGENTINFLOW is about
           165px; with three links and the CTA that overruns a 360px bar and
           pushes the whole page into a horizontal scroll. !important is
           needed because the scroll handler writes --p as an inline style,
           and a stylesheet only outranks that when marked. */
        .wordmark {
            --p: 0 !important;
        }

        .is-fold {
            display: none;
        }

        .nav-links a {
            padding: 0.45rem 0.5rem;
            font-size: 0.82rem;
        }

        .nav-cta span:not(.nav-cta-icon) {
            display: none;
        }

        .nav-cta {
            height: 2.75rem;
            padding: 0.2rem;
            border-color: transparent;
        }

        .nav-cta-icon {
            width: 2.35rem;
            height: 2.35rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .nav-links a,
        .nav-cta,
        .nav-cta-icon,
        .wordmark {
            transition: none;
        }

        .nav-links .label::after {
            transition: none;
        }

        .nav-cta:hover .nav-cta-icon {
            animation: none;
        }
    }
</style>

<script>
    // Folds the logotype as the page leaves the top: full name at rest,
    // AF once scrolled. Driven from the nav rather than the hero because
    // the nav is fixed - anchored in the hero, the same scroll that played
    // the fold carried it off screen.
    const mark = document.querySelector<HTMLElement>('.site-nav .wordmark');

    if (mark && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const folds = Array.from(mark.querySelectorAll<HTMLElement>('.is-fold'));

        // Natural widths must be read at full size, so the class that
        // constrains them is dropped first.
        const measure = () => {
            mark.classList.remove('is-ready');
            folds.forEach((el) => el.style.removeProperty('--w'));
            const widths = folds.map((el) => el.getBoundingClientRect().width);
            folds.forEach((el, i) => el.style.setProperty('--w', `${widths[i].toFixed(2)}px`));
            mark.classList.add('is-ready');
        };

        // Pixels of scroll the unfold takes. Short on purpose: it should be
        // finished well inside the first screen, not tracking the page.
        const RANGE = 200;

        // AF at the top of the page, opening to the full name as you scroll
        // down and folding back to AF as you return. It tracks the scroll
        // position both ways rather than latching open.
        const update = () => {
            const p = Math.max(0, Math.min(1, window.scrollY / RANGE));
            mark.style.setProperty('--p', p.toFixed(3));
        };

        let queued = false;
        const onScroll = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
                queued = false;
                update();
            });
        };

        const start = () => {
            measure();
            update();
        };

        // Measuring before the webfont swaps in records the fallback's
        // metrics, and every letter then sits at the wrong width.
        if (document.fonts?.ready) {
            document.fonts.ready.then(start);
        } else {
            start();
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => {
            measure();
            update();
        });
    }
</script>
