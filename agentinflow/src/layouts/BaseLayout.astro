---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// global.css is deliberately NOT imported here. Astro emitted the layout's
// stylesheet AFTER the page's, which reversed the original cascade - page
// media queries such as `@media (max-width:640px) { .nav-links{display:none} }`
// lost to global's `.nav-links{display:flex}` and the mobile nav stopped
// hiding. Each page imports global.css first, then its own sheet, so the
// order is explicit and matches the original single-stylesheet ordering.

const { title, description, canonical } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-palette="a">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    <!-- The old site pointed these at ../img/ from the site root, which
         resolved above the document root and 404'd. Absolute paths now. -->
    <link rel="icon" href="/img/agentinflow-logo.png" type="image/png" />
    <link rel="icon" href="/img/agentinflow-logo2.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/img/agentinflow-logo2.png" />

    <meta name="google-site-verification" content="ju9vQiPbb1cA_tEG0_ZDC5OvLYYloZi9xtFsKCrATUA" />

    <!-- Domine for headings and highlights, Inter for everything else.
         Only the weights actually used are requested. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <slot name="head" />

    <!-- Palette preview switch. Lets any URL be viewed in a different
         combination (/?palette=b) while we are choosing. Runs before paint
         so there is no flash. Delete this block once a palette is picked. -->
    <script is:inline>
        (function () {
            var p = new URLSearchParams(location.search).get('palette');
            if (p && ['a', 'b', 'c', 'd'].indexOf(p) !== -1) {
                document.documentElement.setAttribute('data-palette', p);
            }
        })();
    </script>
</head>

<body>
    <Nav />
    <slot />
    <Footer />

    {import.meta.env.DEV && (
        <div class="palette-switcher" aria-label="Palette preview (dev only)">
            <span>palette</span>
            <button type="button" data-set-palette="a" title="Dark, wine buttons">A</button>
            <button type="button" data-set-palette="b" title="Dark, light CTA">B</button>
            <button type="button" data-set-palette="c" title="Light, editorial">C</button>
            <button type="button" data-set-palette="d" title="Cream secondary, wine primary">D</button>
        </div>
        <style is:inline>
            .palette-switcher {
                position: fixed;
                right: 1rem;
                bottom: 1rem;
                z-index: 9999;
                display: flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.5rem 0.65rem;
                border-radius: 9999px;
                background: #000;
                border: 1px solid #444;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
                font: 500 12px/1 ui-sans-serif, system-ui, sans-serif;
                color: #999;
            }

            .palette-switcher span {
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-right: 0.15rem;
            }

            .palette-switcher button {
                width: 26px;
                height: 26px;
                border-radius: 50%;
                cursor: pointer;
                border: 1px solid #555;
                background: #1c1c1c;
                color: #ddd;
                font: inherit;
            }

            .palette-switcher button[aria-pressed='true'] {
                background: #fff;
                color: #000;
                border-color: #fff;
            }
        </style>
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var btns = document.querySelectorAll('[data-set-palette]');

                function mark() {
                    var cur = root.getAttribute('data-palette');
                    btns.forEach(function (b) {
                        b.setAttribute('aria-pressed', String(b.dataset.setPalette === cur));
                    });
                }

                btns.forEach(function (b) {
                    b.addEventListener('click', function () {
                        root.setAttribute('data-palette', b.dataset.setPalette);
                        localStorage.setItem('palette', b.dataset.setPalette);
                        mark();
                    });
                });

                var saved = localStorage.getItem('palette');
                if (saved) root.setAttribute('data-palette', saved);
                mark();
            })();
        </script>
    )}
</body>

</html>
